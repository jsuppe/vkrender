<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only apps signed with our key may bind the renderer service. -->
    <permission
        android:name="dev.vkrender.permission.BIND_RENDERER"
        android:protectionLevel="signature" />

    <application
        android:label="vkrender renderer"
        android:allowBackup="false">

        <!-- The Vulkan renderer: NativeActivity driven by android_main.cpp -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vkrender_renderer" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Renderer-owned Surface handed to producer APPS over Binder (M10:
             cross-APK; was cross-process within one APK in M8). -->
        <service
            android:name=".RendererService"
            android:exported="true"
            android:permission="dev.vkrender.permission.BIND_RENDERER" />
    </application>
</manifest>
